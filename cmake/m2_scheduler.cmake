# O IDF 6.1 local define preempcao/slicing diretamente em FreeRTOSConfig.h.
# Gere uma copia para este build e use-a no kernel E nos consumidores.
# Um -D aplicado apenas ao main.c nao mudaria o comportamento do escalonador.
if(NOT CONFIG_FREERTOS_UNICORE)
    message(FATAL_ERROR "Os ensaios M2 exigem CONFIG_FREERTOS_UNICORE=y")
endif()
set(m2_preemption 0)
if(CONFIG_M2_PREEMPTION)
    set(m2_preemption 1)
endif()
set(m2_slicing 0)
if(CONFIG_M2_TIME_SLICING)
    set(m2_slicing 1)
endif()
idf_component_get_property(m2_freertos_dir freertos COMPONENT_DIR)
idf_component_get_property(m2_freertos_lib freertos COMPONENT_LIB)
set(m2_original_config "${m2_freertos_dir}/config/include/freertos/FreeRTOSConfig.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${m2_original_config}")
file(READ "${m2_original_config}" m2_config)
foreach(m2_macro IN ITEMS configUSE_PREEMPTION configUSE_TIME_SLICING)
    string(REGEX MATCHALL "#define[ \t]+${m2_macro}[ \t]+[01]" m2_matches "${m2_config}")
    list(LENGTH m2_matches m2_count)
    if(NOT m2_count EQUAL 1)
        message(FATAL_ERROR "SDK diferente do validado: revisar ${m2_macro} antes de compilar")
    endif()
endforeach()
string(REGEX REPLACE "(#define[ \t]+configUSE_PREEMPTION[ \t]+)[01]" "\\1${m2_preemption}" m2_config "${m2_config}")
string(REGEX REPLACE "(#define[ \t]+configUSE_TIME_SLICING[ \t]+)[01]" "\\1${m2_slicing}" m2_config "${m2_config}")
set(m2_config_dir "${CMAKE_BINARY_DIR}/m2_freertos_config")
file(MAKE_DIRECTORY "${m2_config_dir}/freertos")
file(CONFIGURE OUTPUT "${m2_config_dir}/freertos/FreeRTOSConfig.h"
    CONTENT "${m2_config}" @ONLY)
target_include_directories(${m2_freertos_lib} BEFORE PUBLIC
    "${m2_config_dir}" "${m2_config_dir}/freertos")
message(STATUS "M2: preemption=${m2_preemption}; slicing=${m2_slicing}; override local ao build")
